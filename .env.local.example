# Optional local MicroPiHQ configuration.
# Copy this file to .env.local in the project or installed MicroPiHQ root.

# Development machine only:
# PICAM_API_TARGET=http://Raspi3B-1.local:8000
# PI_HOST=Raspi3B-1.local

# Optional application overrides.
# Without overrides, MicroPiHQ uses these defaults:
# AEB_STOPS=1.5
# SATURATION_FACTOR=2.0
# AU_FIXED_GAIN=2.0

# Uncomment only values you want to override.
# AEB_STOPS=1.5
# SATURATION_FACTOR=2.0
# AU_FIXED_GAIN=2.0
